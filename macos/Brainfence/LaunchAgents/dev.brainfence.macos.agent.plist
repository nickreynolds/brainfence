<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Registered via SMAppService.agent(plistName:). Starts Brainfence at login and
  relaunches it if it is killed (force quit, crash). A normal quit exits with
  status 0, which launchd leaves alone (SuccessfulExit = false).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.brainfence.macos.agent</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/Brainfence</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
