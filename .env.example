# Supabase
# Found in: Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Postgres connection string (used by PowerSync for logical replication)
# Found in: Supabase dashboard → Project Settings → Database → Connection string (URI mode)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# PowerSync (self-hosted)
# POWERSYNC_URL: the address of your running PowerSync Docker instance
POWERSYNC_URL=http://localhost:8080

# Supabase JWKS endpoint — used by PowerSync for RS256 JWT validation (no shared secret needed)
# Format: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Production: domain for Caddy HTTPS reverse proxy (used by docker-compose.prod.yml)
CADDY_DOMAIN=powersync.yourdomain.com
# The public website (site/), served by the same Caddy. Default brainfence.online.
# SITE_DOMAIN=yourdomain.com

# Deploy (npm run deploy): SSH access to the PowerSync droplet, as
# root@POWERSYNC_SSH_IP. The commented ones are optional overrides. The Supabase DB password comes from
# SUPABASE_DB_URL above (or set SUPABASE_DB_PASSWORD).
POWERSYNC_SSH_IP=
# DEPLOY_SSH_TARGET=root@powersync.brainfence.online   # overrides root@$POWERSYNC_SSH_IP
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_REMOTE_DIR=/root/brainfence

# npm run deploy also sets Supabase Auth's Site URL / Redirect URLs with a
# personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Dev bootstrap test user (created by dev/bootstrap.ts)
BOOTSTRAP_USER_EMAIL=test@brainfence.dev
BOOTSTRAP_USER_PASSWORD=

# Android release signing (RELEASING.md). Keep the keystore outside the repo and
# backed up: Play and every installed copy only accept updates signed with it.
# ANDROID_KEYSTORE_PATH=/Users/you/keys/brainfence-release.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=brainfence
# ANDROID_KEY_PASSWORD=
