{
  "description": "Task occurrence status and whether a rule condition is unmet. Each case merges `task` over `base_task`; `now` and `last_completion_at` are instants (all dates below are EST, -05:00). Evaluate in `time_zone`. `home` is the home presence (AT_HOME | AWAY | UNKNOWN | UNCONFIGURED). See shared/CONTRACTS.md (Task occurrences and blocking).",
  "time_zone": "America/New_York",
  "base_task": {
    "recurrence_type": "weekly",
    "recurrence_config": {"day": "mon"},
    "carry_over": 1,
    "available_from": "12:00",
    "due_at": "21:00",
    "home_only_blocking": 1,
    "blocking_days_of_week": ["mon", "tue", "wed", "thu", "fri"],
    "created_at": "2026-11-01T12:00:00Z"
  },
  "cases": [
    {"name": "Monday morning: not open yet", "now": "2026-11-09T10:00:00-05:00", "home": "AT_HOME",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "BEFORE_START", "unmet": false}},
    {"name": "Monday evening: active", "now": "2026-11-09T20:00:00-05:00", "home": "AT_HOME",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "ACTIVE", "unmet": false}},
    {"name": "Monday after 9pm at home: blocks", "now": "2026-11-09T21:30:00-05:00", "home": "AT_HOME",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Monday after 9pm away: home-only lets it go", "now": "2026-11-09T21:30:00-05:00", "home": "AWAY",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "PAST_DUE", "unmet": false}},
    {"name": "Monday after 9pm, home unknown: strict", "now": "2026-11-09T21:30:00-05:00", "home": "UNKNOWN",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Monday after 9pm, done at the gym", "now": "2026-11-09T21:30:00-05:00", "home": "AT_HOME",
     "last_completion_at": "2026-11-09T19:10:00-05:00",
     "expect": {"scheduled": true, "completed": true, "carried_over": false, "phase": "PAST_DUE", "unmet": false}},
    {"name": "Tuesday morning, skipped: carried over and blocking all day", "now": "2026-11-10T08:00:00-05:00", "home": "AT_HOME",
     "last_completion_at": "2026-11-02T19:00:00-05:00",
     "expect": {"scheduled": true, "completed": false, "carried_over": true, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Tuesday morning, done Monday", "now": "2026-11-10T08:00:00-05:00", "home": "AT_HOME",
     "last_completion_at": "2026-11-09T19:00:00-05:00",
     "expect": {"scheduled": true, "completed": true, "carried_over": true, "phase": "PAST_DUE", "unmet": false}},
    {"name": "Wednesday night, made up Tuesday morning", "now": "2026-11-11T22:00:00-05:00", "home": "AT_HOME",
     "last_completion_at": "2026-11-10T07:00:00-05:00",
     "expect": {"scheduled": true, "completed": true, "carried_over": true, "phase": "PAST_DUE", "unmet": false}},
    {"name": "Friday, still skipped, away on vacation", "now": "2026-11-13T15:00:00-05:00", "home": "AWAY",
     "expect": {"scheduled": true, "completed": false, "carried_over": true, "phase": "PAST_DUE", "unmet": false}},
    {"name": "Saturday, still skipped: not a blocking day", "now": "2026-11-14T12:00:00-05:00", "home": "AT_HOME",
     "expect": {"scheduled": true, "completed": false, "carried_over": true, "phase": "PAST_DUE", "unmet": false}},
    {"name": "Next Monday morning: a fresh occurrence replaces the skipped one", "now": "2026-11-16T10:00:00-05:00", "home": "AT_HOME",
     "last_completion_at": "2026-11-02T19:00:00-05:00",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "BEFORE_START", "unmet": false}},
    {"name": "Next Monday morning, last week's done", "now": "2026-11-16T10:00:00-05:00", "home": "AT_HOME",
     "last_completion_at": "2026-11-10T07:00:00-05:00",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "BEFORE_START", "unmet": false}},
    {"name": "Carry-over doesn't reach back before the task existed", "now": "2026-11-12T22:00:00-05:00", "home": "AT_HOME",
     "task": {"created_at": "2026-11-11T15:00:00Z"},
     "expect": {"scheduled": false, "completed": false, "carried_over": false, "phase": null, "unmet": false}},
    {"name": "Created the same Monday, after the occurrence started", "now": "2026-11-10T08:00:00-05:00", "home": "AT_HOME",
     "task": {"created_at": "2026-11-09T18:00:00Z"},
     "expect": {"scheduled": true, "completed": false, "carried_over": true, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Postgres timestamp text for created_at", "now": "2026-11-10T08:00:00-05:00", "home": "AT_HOME",
     "task": {"created_at": "2026-11-09 18:00:00.123+00"},
     "expect": {"scheduled": true, "completed": false, "carried_over": true, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Without carry-over, a weekly task isn't due the next day", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"carry_over": 0},
     "expect": {"scheduled": false, "completed": false, "carried_over": false, "phase": null, "unmet": false}},
    {"name": "Without carry-over, done Monday doesn't block Tuesday night", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"carry_over": 0}, "last_completion_at": "2026-11-09T19:00:00-05:00",
     "expect": {"scheduled": false, "completed": false, "carried_over": false, "phase": null, "unmet": false}},
    {"name": "Done today on a day it isn't scheduled", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"carry_over": 0}, "last_completion_at": "2026-11-10T19:00:00-05:00",
     "expect": {"scheduled": false, "completed": true, "carried_over": false, "phase": null, "unmet": false}},
    {"name": "Selected days: off day isn't due", "now": "2026-11-13T10:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "daily", "recurrence_config": {"days": ["mon", "tue", "wed", "thu"]}, "carry_over": 0,
              "available_from": "00:01", "due_at": "09:00", "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": false, "completed": false, "carried_over": false, "phase": null, "unmet": false}},
    {"name": "Selected days with carry-over: Wednesday still owes Monday's", "now": "2026-11-11T08:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "daily", "recurrence_config": {"days": ["mon", "thu"]},
              "available_from": "06:00", "due_at": "09:00", "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": true, "completed": false, "carried_over": true, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Selected days with carry-over: Thursday's own occurrence takes over", "now": "2026-11-12T08:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "daily", "recurrence_config": {"days": ["mon", "thu"]},
              "available_from": "06:00", "due_at": "09:00", "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "ACTIVE", "unmet": false}},
    {"name": "Daily: done yesterday, overdue today", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "daily", "recurrence_config": {}, "carry_over": 0, "home_only_blocking": 0, "blocking_days_of_week": []},
     "last_completion_at": "2026-11-09T19:00:00-05:00",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Daily with no window blocks until done", "now": "2026-11-10T08:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "daily", "recurrence_config": {}, "carry_over": 0, "available_from": null, "due_at": null,
              "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": null, "unmet": true}},
    {"name": "Monthly (2nd Wednesday) carried over to Friday", "now": "2026-11-13T09:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "monthly", "recurrence_config": {"week": 2, "day": "wed"}, "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": true, "completed": false, "carried_over": true, "phase": "PAST_DUE", "unmet": true}},
    {"name": "Monthly without carry-over: not due the day after", "now": "2026-11-12T22:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "monthly", "recurrence_config": {"week": 2, "day": "wed"}, "carry_over": 0, "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": false, "completed": false, "carried_over": false, "phase": null, "unmet": false}},
    {"name": "Unparseable recurrence config fails closed (every day)", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_config": {}, "carry_over": 0, "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "PAST_DUE", "unmet": true}},
    {"name": "One-off, never done", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": null, "recurrence_config": {}, "carry_over": 0, "available_from": null, "due_at": null,
              "home_only_blocking": 0, "blocking_days_of_week": []},
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": null, "unmet": true}},
    {"name": "One-off done long ago stays done", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": null, "recurrence_config": {}, "carry_over": 0, "available_from": null, "due_at": null,
              "home_only_blocking": 0, "blocking_days_of_week": []},
     "last_completion_at": "2026-10-01T10:00:00-04:00",
     "expect": {"scheduled": true, "completed": true, "carried_over": false, "phase": null, "unmet": false}},
    {"name": "Interval tasks ignore carry-over", "now": "2026-11-10T22:00:00-05:00", "home": "AT_HOME",
     "task": {"recurrence_type": "interval", "recurrence_config": {"minutes": 480}, "home_only_blocking": 0, "blocking_days_of_week": []},
     "last_completion_at": "2026-11-09T19:00:00-05:00",
     "expect": {"scheduled": true, "completed": false, "carried_over": false, "phase": "PAST_DUE", "unmet": true}}
  ]
}
